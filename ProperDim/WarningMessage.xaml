<Window x:Class="ProperDim.WarningMessage"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="ProperDim" Height="150" Width="300"
        MinHeight="150" MinWidth="300"
        WindowStyle="None" ResizeMode="NoResize"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
	<WindowChrome.WindowChrome>
		<WindowChrome GlassFrameThickness="1" CornerRadius="0" CaptionHeight="0" UseAeroCaptionButtons="False" ResizeBorderThickness="0" />
	</WindowChrome.WindowChrome>
	<Grid>
		<!-- Static outer frame to maintain perfect 8px physical edge regardless of scale -->
		<Border Background="#2D2D2D" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" />

		<Grid Margin="1">
			<!-- Mask generator (matches app background color to prevent white flashes) -->
			<Border Name="MaskBorder" Background="#2D2D2D" CornerRadius="7" />

			<Grid>
				<Grid.OpacityMask>
					<VisualBrush Visual="{Binding ElementName=MaskBorder}" />
				</Grid.OpacityMask>

				<Viewbox Stretch="Uniform">
					<Grid Width="298" Height="148">
						<Grid.RowDefinitions>
							<RowDefinition Height="30" />
							<RowDefinition Height="*" />
							<RowDefinition Height="50" />
						</Grid.RowDefinitions>

						<!-- CornerRadius removed because OpacityMask natively clips the curves perfectly -->
						<Border Name="TitleBar" Grid.Row="0" Background="#1E1E1E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
							<TextBlock Name="TitleText" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
			</Border>
			<TextBlock Name="MessageText" Grid.Row="1" Foreground="White" TextWrapping="Wrap" Margin="15,15,15,0" TextAlignment="Center" VerticalAlignment="Center" />
			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
				<Button x:Name="PrimaryButton" Content="It is" Width="75" Height="25" Background="#993333" Foreground="White" BorderBrush="#555" BorderThickness="1" Margin="0,0,15,0" Cursor="Hand" Click="Yes_Click" FocusVisualStyle="{StaticResource GrayFocusVisual}">
					<Button.Template>
						<ControlTemplate TargetType="{x:Type Button}">
							<Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="border" Property="Background" Value="IndianRed" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>
				<Button x:Name="SecondaryButton" Content="It's not" Width="75" Height="25" Background="#3E3E42" Foreground="White" BorderBrush="#555" BorderThickness="1" Cursor="Hand" Click="No_Click" FocusVisualStyle="{StaticResource GrayFocusVisual}">
					<Button.Template>
						<ControlTemplate TargetType="{x:Type Button}">
							<Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="border" Property="Background" Value="#4E4E52" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>
						</StackPanel>
					</Grid>
				</Viewbox>
			</Grid>
		</Grid>

		<!-- Thumb remains outside the Viewbox to retain fixed size -->
		<Thumb Width="12" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" Background="Transparent" Margin="0,0,2,2">
			<Thumb.Template>
				<ControlTemplate TargetType="{x:Type Thumb}">
					<Border Background="{TemplateBinding Background}">
						<Path Data="M 8,14 L 14,8 M 2,14 L 14,2" Stroke="#555555" StrokeThickness="1.25" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
					</Border>
				</ControlTemplate>
			</Thumb.Template>
		</Thumb>
	</Grid>
</Window>